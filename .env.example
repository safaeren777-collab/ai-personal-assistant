# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file as .env and fill in your values
# ============================================================

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Google Gemini API (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets
SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
SHEETS_CREDENTIALS_FILE=credentials.json
